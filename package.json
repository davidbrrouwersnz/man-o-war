{
  "name": "man-o-war",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prebuild": "node scripts/split.mjs && node scripts/contrast.mjs",
    "contrast": "node scripts/contrast.mjs",
    "predev": "node scripts/split.mjs",
    "prepreview": "node scripts/split.mjs",
    "audio": "node --env-file-if-exists=.env.local scripts/audio.mjs",
    "audio:check": "node scripts/audio.mjs --dry-run",
    "audio:probe": "node --env-file-if-exists=.env.local scripts/audio.mjs --probe",
    "translate:units": "node scripts/units.mjs",
    "translate:audit": "node scripts/translate-guard.mjs",
    "pronunciation": "node scripts/pronunciation-review.mjs",
    "pronunciation:qa": "node scripts/pronunciation-qa.mjs",
    "audio:smoke": "node scripts/audio-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.7"
  }
}

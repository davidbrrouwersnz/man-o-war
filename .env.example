# Copy this file to .env.local and put the real values in that copy.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. This file is not, so never put a real key in it.
# The audio scripts pick .env.local up automatically - there is nothing to export or source.

# Azure Speech, for generating the English narration (npm run audio).
# Portal -> your Speech resource -> Keys and Endpoint. Either key works.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast

# Azure Translator, for keeping the translations in step with the English (npm run translate).
# A separate resource from Speech, with its own key.
#
# Leave the endpoint at the global host to use neural machine translation. It works, and it honours
# class="notranslate", which is what keeps the 126 binomials out of the translator's reach.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
# Only needed for a regional resource. Falls back to AZURE_SPEECH_REGION when unset.
AZURE_TRANSLATOR_REGION=

# LLM translation instead of NMT, which §7 puts at 85-90% of professional quality against NMT's
# rather less. It is not a setting on the resource above: it needs an Azure AI Foundry resource
# with a model deployed in it, and the endpoint then looks like
#
#   https://<resource>.services.ai.azure.com
#
# Set that as AZURE_TRANSLATOR_ENDPOINT, put the deployment's name here, and scripts/translate.mjs
# switches engines on its own — it decides from what the endpoint can actually reach rather than
# from what it was asked for, because a run that used one engine and recorded another would make
# the ledger a liar. The global host answers 404 to the API version LLM translation needs.
#
# Worth doing: NMT renders "Portuguese man o' war" as "portugiesisches Kriegsschiff" — a warship,
# not the animal. The German for it is "Portugiesische Galeere".
AZURE_TRANSLATOR_DEPLOYMENT=

# ---------------------------------------------------------------------------------------------
# Do NOT rename these to start with VITE_.
#
# Vite copies any variable beginning with VITE_ into the JavaScript it sends to the browser, in
# plain text, where anyone can read it with View Source. That is intended for things like a public
# analytics ID - it is exactly wrong for a key that can be billed. These names are deliberately
# unprefixed so that cannot happen by accident.
#
# Nothing here is needed to run or build the site. The audio is generated ahead of time and shipped
# as files, so the app itself never talks to Azure and needs no key at all.
# ---------------------------------------------------------------------------------------------

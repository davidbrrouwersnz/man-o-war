# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Secrets. The real key lives in .env.local; .env.example is the checked-in template and is the
# ONLY one of these that should ever be committed. "*.local" above already catches .env.local, but
# these are spelled out because the failure is silent and expensive: a plain ".env" was not covered,
# so anyone who named the file the obvious thing would have committed their key.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Stray audio-generation artifacts — not used by the app (which uses audio-guide.mp3)
public/Voice.wav
public/*Seed Audio*
public/*.zip

# Private working files — seed-audio reference recordings, scratch tooling. Kept out of public/
# because Vite copies public/ into dist wholesale: anything that lands there is one deploy away
# from being publicly downloadable at a guessable URL.
working/

.vercel

# Generated by scripts/split.mjs at build time from manifest.json
src/data/chunks/
